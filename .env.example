# MySQL 8.0+ database. Create the database and grant this user access before migrating.
DATABASE_URL="mysql://formyst:change-me@127.0.0.1:3306/formyst"
APP_URL="http://localhost:3000"

# Optional. Create a Google OAuth web client and register:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. Local Ollama defaults work without these settings.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b"

# Used once by npm run db:seed. Remove the password after creating the admin.
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-unique-password"

# Optional. Only set when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY="false"

# Optional. Exact HTTPS host names (and ports) allowed for outbound webhooks.
# Include each service you configure, for example hooks.slack.com, discord.com,
# hooks.zapier.com, or a region-specific Make hook host.
WEBHOOK_ALLOWED_HOSTS=""
