{
  "name": "formyst",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
